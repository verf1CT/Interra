# Порт HTTP-сервера
PORT=8080

# Токен администратора для входа в панель рассылки и админ-API.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Путь к service account ключу Firebase
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Файл базы данных SQLite
DB_PATH=./data/interra.sqlite

# ==============================================================================
# Чат-бот на платформе MAX (https://business.max.ru/self/chat-bots)
# ==============================================================================
# Токен бота из личного кабинета MAX для бизнеса (раздел Чат-боты -> Настройки)
MAX_BOT_TOKEN=change-me-to-your-max-bot-token

# Токен бота Telegram (опционально, если параллельно используется Telegram)
TELEGRAM_BOT_TOKEN=change-me-to-your-telegram-bot-token

# Чат отдела продаж для мгновенных уведомлений о новых заявках на подключение
TELEGRAM_SALES_CHAT_ID=-1001234567890

# Интеграция с Биллингом (UTM5 / API Интерра)
# Если переменные не заданы — используется реалистичный встроенный мок-сервер
BILLING_API_URL=
BILLING_API_TOKEN=

# Интеграция с CRM / Helpdesk (заявки мастеров, лиды, передача операторам)
CRM_API_URL=
CRM_API_TOKEN=

# Шлюз СБП для динамической генерации ссылок на оплату
SBP_API_URL=https://interra.ru/pay
