{
  "name": "interra-server",
  "version": "0.1.0",
  "description": "Бэкенд ЛК Интерра: регистрация устройств, рассылка push и чат-бот поддержки/продаж на платформе MAX",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "bot": "node src/bot/standalone.js",
    "bot:max": "node src/bot/maxStandalone.js",
    "bot:sim": "node src/bot/simulator.js",
    "build-ui": "cd admin-ui && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  }
}
